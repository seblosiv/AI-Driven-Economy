# Production Environment Variables
# Copy this to .env and fill in your values

# Database (auto-generated by most platforms)
DATABASE_URL=postgresql://user:password@host:5432/database
POSTGRES_USER=lifeafterai
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD
POSTGRES_DB=lifeafterai

# Security (REQUIRED - generate secure random strings)
SECRET_KEY=CHANGE_ME_TO_RANDOM_32_CHAR_STRING

# URLs (update with your actual domains)
FRONTEND_URL=https://your-app.com
BACKEND_URL=https://api.your-app.com
VITE_API_URL=https://api.your-app.com

# CORS (comma-separated allowed origins)
CORS_ORIGINS=https://your-app.com,https://www.your-app.com

# Environment
ENVIRONMENT=production

# Optional: AI Provider (falls back to rules if not set)
OPENAI_API_KEY=
AI_PROVIDER=local

# Optional: Stripe Payments
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_MONTHLY=
STRIPE_PRICE_ID_YEARLY=

# Optional: Email (Resend)
RESEND_API_KEY=
FROM_EMAIL=hello@your-app.com

# Optional: PostHog Analytics
POSTHOG_API_KEY=
POSTHOG_HOST=https://app.posthog.com
