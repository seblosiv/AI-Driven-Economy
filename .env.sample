# Database
DATABASE_URL=postgresql://lifeafterai:lifeafterai@db:5432/lifeafterai
DATABASE_URL_DEV=sqlite:///./lifeafterai.db

# JWT & Auth
SECRET_KEY=your-secret-key-change-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# OAuth (Google)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# AI Provider (optional - fallback to rules-based if not set)
OPENAI_API_KEY=
DEEPINFRA_API_KEY=
GROQ_API_KEY=
AI_PROVIDER=openai  # openai | deepinfra | groq | local

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_PRICE_ID_MONTHLY=price_monthly
STRIPE_PRICE_ID_YEARLY=price_yearly

# Email (Resend)
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=hello@lifeafterai.com

# PostHog Analytics
POSTHOG_API_KEY=phc_your_posthog_key
POSTHOG_HOST=https://app.posthog.com

# App
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
ENVIRONMENT=development  # development | production

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
